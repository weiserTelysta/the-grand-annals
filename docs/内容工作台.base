filters:
  and:
    - 'file.ext == "md"'
    - not:
        - 'file.inFolder("_templates")'

formulas:
  section: 'if(file.inFolder("zh/星辰微光"), "人物档案", if(file.inFolder("zh/山河地理"), "山河地理", if(file.inFolder("zh/法则设定"), "世界法则", if(file.inFolder("zh/历史纪元"), "历史纪元", if(file.inFolder("zh/文明诸邦"), "文明诸邦", if(file.inFolder("zh/众生谱系"), "众生谱系", "其他"))))))'
  requiresRelated: 'file.name != "index" and file.name != "404"'
  completeness: 'if(title and description, if(formula.requiresRelated and related.isEmpty(), "可补关联", "就绪"), "缺少必填项")'

properties:
  file.name:
    displayName: 条目
  formula.section:
    displayName: 栏目
  formula.completeness:
    displayName: 完整度
  title:
    displayName: 页面标题
  description:
    displayName: 一句话简介
  type:
    displayName: 类型
  workflow:
    displayName: 工作流
  tags:
    displayName: 标签
  aliases:
    displayName: 别名与译名
  related:
    displayName: 相关条目
  file.mtime:
    displayName: 最近修改

views:
  - type: table
    name: 公开内容
    filters:
      and:
        - 'file.inFolder("zh")'
    order:
      - file.name
      - formula.section
      - formula.completeness
      - title
      - description
      - tags
      - related
      - file.mtime

  - type: table
    name: 待补必填项
    filters:
      and:
        - 'file.inFolder("zh")'
        - or:
            - 'title.isEmpty()'
            - 'description.isEmpty()'
    order:
      - file.name
      - formula.section
      - title
      - description
      - file.mtime

  - type: table
    name: 知识条目待补关联
    filters:
      and:
        - 'file.inFolder("zh")'
        - 'formula.requiresRelated'
        - 'related.isEmpty()'
    order:
      - file.name
      - formula.section
      - related
      - file.mtime

  - type: table
    name: 非发布草稿
    filters:
      and:
        - 'file.inFolder("weiser")'
    order:
      - file.name
      - workflow
      - tags
      - file.mtime

  - type: table
    name: 最近修改
    limit: 50
    filters:
      and:
        - 'file.mtime > now() - "30d"'
    order:
      - file.name
      - formula.section
      - workflow
      - file.mtime
